# Resend API Key for sending contact form emails
# Obtain your key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# (Optional) Recipient email address for contact submissions. Defaults to selvapatinyo@gmail.com
CONTACT_RECIPIENT_EMAIL=selvapatinyo@gmail.com

# (Optional) Verified sender email address in Resend. Defaults to 'Selva Terapia <contacto@selvaterapia.com>'
RESEND_FROM_EMAIL="Selva Terapia <contacto@selvaterapia.com>"
